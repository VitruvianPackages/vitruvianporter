"""Builds V\\OS port packages in a clean V\\OS build root."""

import argparse
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile

REPO = "https://repo.v-os.dev"
REPO_KEY = REPO + "/repo-key.asc"
SUITES = {
	"trixie": "trixie",
	"trixie-nightly": "trixie",
	"testing": "testing",
	"testing-nightly": "testing",
}
TOOLS = ("ca-certificates curl gpg build-essential debhelper devscripts equivs "
	"fakeroot dpkg-dev attr git quilt")
PORT_KEYS = {"git", "commit", "subdir", "debian", "version"}
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME",
	os.path.expanduser("~/.cache")), "vitruvianporter")


class PortError(Exception):
	pass


def die(msg):
	print("vitruvianporter: " + msg, file=sys.stderr)
	sys.exit(1)


def run(cmd, **kw):
	print("+ " + " ".join(cmd), file=sys.stderr)
	return subprocess.run(cmd, check=True, **kw)


# ---- the ports tree ---------------------------------------------------

def read_port_yaml(path):
	fields = {}
	with open(path) as f:
		for n, line in enumerate(f, 1):
			line = line.split("#", 1)[0].strip()
			if not line:
				continue
			m = re.match(r"^([a-z]+):\s*(\S.*)$", line)
			if not m or m.group(1) not in PORT_KEYS:
				raise PortError("%s:%d: expected one of %s" % (path, n,
					", ".join(sorted(PORT_KEYS))))
			fields[m.group(1)] = m.group(2).strip().strip('"')
	if ("git" in fields) == ("debian" in fields):
		raise PortError("%s: set either git+commit or debian+version" % path)
	if "git" in fields and "commit" not in fields:
		raise PortError("%s: git needs commit" % path)
	if "debian" in fields and "version" not in fields:
		raise PortError("%s: debian needs version" % path)
	return fields


def control_paragraphs(path):
	paras, cur, key = [], {}, None
	with open(path) as f:
		for line in f:
			if line.startswith("#"):
				continue
			if not line.strip():
				if cur:
					paras.append(cur)
				cur, key = {}, None
				continue
			if line[0] in " \t" and key:
				cur[key] += " " + line.strip()
				continue
			key, _, value = line.partition(":")
			key = key.strip()
			cur[key] = value.strip()
	if cur:
		paras.append(cur)
	return paras


def dep_names(field):
	names = []
	for alt in re.split(r"[,|]", field or ""):
		alt = re.sub(r"\(.*?\)|\[.*?\]|<.*?>", "", alt).strip()
		if alt and not alt.startswith("$"):
			names.append(alt.split(":")[0])
	return names


class Port:
	def __init__(self, path):
		self.path = path
		self.name = os.path.basename(path)
		self.debian = os.path.join(path, "debian")
		self.fields = read_port_yaml(os.path.join(path, "port.yaml"))
		if self.kind == "git":
			paras = control_paragraphs(os.path.join(self.debian, "control"))
			self.source = paras[0]["Source"]
			self.build_depends = dep_names(paras[0].get("Build-Depends", ""))
			self.binaries = [p["Package"] for p in paras[1:] if "Package" in p]
		else:
			# Patched Debian package: Debian's debian/ is used as is.
			self.source = self.fields["debian"]
			self.build_depends, self.binaries = [], []
		with open(os.path.join(self.debian, "changelog")) as f:
			m = re.match(r"^\S+ \(([^)]+)\)", f.readline())
		if not m:
			raise PortError("bad debian/changelog")
		self.version = m.group(1)
		up = self.version.split(":", 1)[-1]
		self.upstream = up.rsplit("-", 1)[0] if "-" in up else up

	@property
	def kind(self):
		return "git" if "git" in self.fields else "debian"


def find_ports(tree):
	ports, broken = {}, {}
	root = os.path.join(tree, "ports")
	for dirpath, dirnames, filenames in os.walk(root):
		if "port.yaml" not in filenames:
			continue
		dirnames[:] = []
		name = os.path.basename(dirpath)
		if name in ports or name in broken:
			die("two ports named %s" % name)
		try:
			ports[name] = Port(dirpath)
		except (PortError, OSError, KeyError, IndexError) as e:
			broken[name] = str(e)
	return ports, broken


def select(ports, names, everything):
	if everything:
		return order(ports, list(ports))
	missing = [n for n in names if n not in ports]
	if missing:
		die("no such port: " + ", ".join(missing))
	return order(ports, names)


def order(ports, names):
	# Ports whose binaries another selected port build-depends on go first.
	by_binary = {b: p.name for p in ports.values() for b in p.binaries}
	done, out, active = set(), [], set()

	def visit(name):
		if name in done:
			return
		if name in active:
			die("build-dependency cycle through " + name)
		active.add(name)
		for dep in ports[name].build_depends:
			if dep in by_binary and by_binary[dep] in names:
				visit(by_binary[dep])
		active.discard(name)
		done.add(name)
		out.append(ports[name])

	for n in sorted(names):
		visit(n)
	return out


# ---- checks -----------------------------------------------------------



def check_port(port):
	errors, warnings = [], []
	f = port.fields
	if port.kind == "git":
		if not f["git"].startswith("https://"):
			errors.append("git: not an https URL: " + f["git"])
		if not re.fullmatch(r"[0-9a-f]{40}", f["commit"]):
			errors.append("commit: not a full sha")
		if "subdir" in f and not re.fullmatch(r"[\w.-]+(/[\w.-]+)*", f["subdir"]) \
				or ".." in f.get("subdir", ""):
			errors.append("subdir: not a relative path")
	needed = ("control", "changelog", "rules", "copyright", "source/format")
	if port.kind == "debian":
		needed = ("changelog",)
	for need in needed:
		if not os.path.exists(os.path.join(port.debian, need)):
			errors.append("debian/%s missing" % need)
	for dirpath, _, filenames in os.walk(port.debian):
		for fn in filenames:
			path = os.path.join(dirpath, fn)
			rel = os.path.relpath(path, port.path)
			in_patches = "/patches/" in "/" + rel
			if fn.endswith(".sh") and not in_patches:
				errors.append("%s: wrapper script in debian/" % rel)
			try:
				text = open(path, encoding="utf-8").read()
			except (UnicodeDecodeError, OSError):
				continue
			if fn in ("postinst", "postrm", "preinst", "prerm") and \
					re.search(r"setfattr|apps_attrs", text):
				errors.append("%s: restores attributes itself; dh-vos does" % rel)
			if fn == "rules" and port.kind == "git":
				if re.search(r"override_dh_(shlibdeps|strip|dwz)", text):
					errors.append("rules: overrides a step dh-vos owns")
				if "--with vos" not in text and "--with=vos" not in text:
					warnings.append("rules: dh is not run --with vos")
	return errors, warnings


# ---- the build root ---------------------------------------------------

def image(suite, arch):
	return "vitruvianporter/buildroot:%s-%s" % (suite, arch)


DOCKERFILE = """\
FROM docker.io/library/debian:{base}
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \\
 && apt-get update && apt-get install -y --no-install-recommends \\
	{tools}
{repo}COPY extra/ /opt/extra/
RUN apt-get update \\
 && if ls /opt/extra/*.deb >/dev/null 2>&1; then apt-get install -y /opt/extra/*.deb; fi \\
 && apt-get install -y vos-dev dh-vos \\
 && apt-get clean
ENV PATH=/usr/lib/vos/buildtools:$PATH
"""

DOCKER_REPO = """\
RUN curl -fsSL {key} | gpg --dearmor -o /usr/share/keyrings/vitruvian.gpg \\
 && echo "deb [signed-by=/usr/share/keyrings/vitruvian.gpg] {repo} {suite} main" \\
	> /etc/apt/sources.list.d/vitruvian.list
"""


# Native mode: this machine is the build root, for a throwaway VM that
# already runs the suite's Debian base.
NATIVE_SETUP = r"""
set -e
export DEBIAN_FRONTEND=noninteractive
S=/etc/apt/sources.list.d/debian.sources
if [ -f $S ]; then sed -i 's/^Types: deb$/Types: deb deb-src/' $S; fi
apt-get update
apt-get install -y --no-install-recommends $TOOLS
if [ -z "$NO_REPO" ]; then
	curl -fsSL "$REPO_KEY" | gpg --dearmor --yes -o /usr/share/keyrings/vitruvian.gpg
	echo "deb [signed-by=/usr/share/keyrings/vitruvian.gpg] $REPO $SUITE main" \
		> /etc/apt/sources.list.d/vitruvian.list
	apt-get update
fi
if [ -n "$EXTRA" ]; then apt-get install -y $EXTRA; fi
apt-get install -y vos-dev dh-vos
apt-get clean
"""


def check_native(args, install=False):
	if install and os.geteuid() != 0:
		die("--native bootstrap installs packages: run it as root")
	arch = subprocess.run(["dpkg", "--print-architecture"], capture_output=True,
		text=True).stdout.strip()
	if arch != args.arch:
		die("--native: this machine is %s, not %s" % (arch, args.arch))
	codename = ""
	with open("/etc/os-release") as f:
		for line in f:
			if line.startswith("VERSION_CODENAME="):
				codename = line.split("=", 1)[1].strip().strip('"')
	if (codename == "trixie") != (SUITES[args.suite] == "trixie"):
		die("--native: this machine runs %s, suite %s needs %s" % (
			codename or "an unknown base", args.suite, SUITES[args.suite]))


def native_env(**extra):
	env = dict(os.environ)
	env.update(extra)
	env["PATH"] = "/usr/lib/vos/buildtools:" + env.get("PATH", "")
	return env


def bootstrap(args):
	if args.suite not in SUITES:
		die("unknown suite " + args.suite)
	if args.native:
		check_native(args, install=True)
		extra = " ".join(os.path.abspath(d) for d in args.extra_deb or [])
		run(["bash", "-c", NATIVE_SETUP], env=native_env(TOOLS=TOOLS,
			REPO=REPO, REPO_KEY=REPO_KEY, SUITE=args.suite, EXTRA=extra,
			NO_REPO="1" if args.no_repo else ""))
		return
	with tempfile.TemporaryDirectory() as ctx:
		os.mkdir(os.path.join(ctx, "extra"))
		for deb in args.extra_deb or []:
			shutil.copy(deb, os.path.join(ctx, "extra"))
		with open(os.path.join(ctx, "Dockerfile"), "w") as f:
			repo = "" if args.no_repo else DOCKER_REPO.format(key=REPO_KEY,
				repo=REPO, suite=args.suite)
			f.write(DOCKERFILE.format(base=SUITES[args.suite], repo=repo,
				tools=TOOLS))
		run(["docker", "build", "--pull", "--platform", "linux/" + args.arch,
			"-t", image(args.suite, args.arch), ctx])


# ---- building ---------------------------------------------------------

def fetch_git(port, work):
	url, commit = port.fields["git"], port.fields["commit"]
	mirror = os.path.join(CACHE, "git", hashlib.sha1(url.encode()).hexdigest())
	if not os.path.isdir(mirror):
		os.makedirs(os.path.dirname(mirror), exist_ok=True)
		run(["git", "init", "-q", "--bare", mirror])
	have = subprocess.run(["git", "-C", mirror, "cat-file", "-e",
		commit + "^{commit}"], capture_output=True).returncode == 0
	if not have:
		run(["git", "-C", mirror, "fetch", "-q", "--depth", "1", url, commit])
	prefix = "%s-%s" % (port.source, port.upstream)
	tree = commit
	if "subdir" in port.fields:
		tree += ":" + port.fields["subdir"]
	orig = os.path.join(work, "%s_%s.orig.tar.gz" % (port.source, port.upstream))
	with open(orig, "wb") as out:
		archive = subprocess.Popen(["git", "-C", mirror, "archive",
			"--prefix=" + prefix + "/", tree], stdout=subprocess.PIPE)
		subprocess.run(["gzip", "-n"], stdin=archive.stdout, stdout=out, check=True)
		if archive.wait() != 0:
			die("%s: git archive failed" % port.name)
	run(["tar", "-xzf", orig, "-C", work])
	src = os.path.join(work, prefix)
	shutil.copytree(port.debian, os.path.join(src, "debian"))
	return prefix


BUILD_SCRIPT = r"""
set -e
# Only installing needs root: without it the build dependencies must
# already be on the machine.
if [ "$(id -u)" = 0 ]; then
	if ls "$OUT"/*.deb >/dev/null 2>&1; then
		(cd "$OUT" && dpkg-scanpackages -m . > Packages)
		echo "deb [trusted=yes] file:$OUT ./" > /etc/apt/sources.list.d/local.list
	fi
	apt-get update -qq
fi
cd "$WORK"
if [ -n "$DEBIAN_SOURCE" ]; then
	apt-get source -qq --only-source "$DEBIAN_SOURCE=$DEBIAN_VERSION"
	SRC=$(find . -mindepth 1 -maxdepth 1 -type d ! -name port | head -1)
	if [ -d port/patches ]; then
		mkdir -p "$SRC/debian/patches"
		for p in $(cat port/patches/series); do
			cp "port/patches/$p" "$SRC/debian/patches/"
			echo "$p" >> "$SRC/debian/patches/series"
		done
	fi
	if [ -f port/rules.diff ]; then patch -d "$SRC" -p1 < port/rules.diff; fi
	cp port/changelog.entry /tmp/entry
	cat "$SRC/debian/changelog" >> /tmp/entry
	cp /tmp/entry "$SRC/debian/changelog"
else
	SRC=$SRCDIR
fi
cd "$SRC"
if [ "$(id -u)" = 0 ]; then
	mk-build-deps -i -r -t 'apt-get -y --no-install-recommends' debian/control
elif ! dpkg-checkbuilddeps; then
	echo "build dependencies missing: install them, or run as root" >&2
	exit 1
fi
dpkg-buildpackage -us -uc -b
cd ..
cp ./*.deb "$OUT"/
chown "$HOST_UID:$HOST_GID" "$OUT"/*.deb
"""


def debian_entry(port, work):
	# Class 2: our debian/ holds only changelog (the vos revision entry),
	# plus patches/ and rules.diff next to it.
	os.makedirs(os.path.join(work, "port"))
	if os.path.isdir(os.path.join(port.path, "patches")):
		shutil.copytree(os.path.join(port.path, "patches"),
			os.path.join(work, "port", "patches"))
	if os.path.exists(os.path.join(port.path, "rules.diff")):
		shutil.copy(os.path.join(port.path, "rules.diff"),
			os.path.join(work, "port"))
	text = open(os.path.join(port.debian, "changelog")).read()
	entry = text.split("\n -- ", 1)
	if len(entry) != 2:
		die("%s: debian/changelog has no entry" % port.name)
	first = entry[0] + "\n -- " + entry[1].split("\n", 1)[0] + "\n\n"
	open(os.path.join(work, "port", "changelog.entry"), "w").write(first)


def build_port(port, args, out):
	work = tempfile.mkdtemp(prefix=port.name + ".", dir=args.work)
	env = {"HOST_UID": str(os.getuid()), "HOST_GID": str(os.getgid())}
	if port.kind == "git":
		env["SRCDIR"] = fetch_git(port, work)
	else:
		debian_entry(port, work)
		env["DEBIAN_SOURCE"] = port.fields["debian"]
		env["DEBIAN_VERSION"] = port.fields["version"]
	log = os.path.join(out, "logs", port.name + ".log")
	with open(log, "w") as logf:
		if args.native:
			# Build dependencies stay installed between ports: the VM is
			# the isolation.
			rc = subprocess.run(["bash", "-c", BUILD_SCRIPT],
				env=native_env(WORK=work, OUT=out,
				DEBIAN_FRONTEND="noninteractive", **env),
				stdout=logf, stderr=subprocess.STDOUT).returncode
		else:
			env.update(WORK="/work", OUT="/out")
			flags = [a for k, v in sorted(env.items()) for a in ("-e", k + "=" + v)]
			rc = subprocess.run(["docker", "run", "--rm",
				"--platform", "linux/" + args.arch,
				"-v", work + ":/work", "-v", out + ":/out"] + flags +
				[image(args.suite, args.arch), "bash", "-c", BUILD_SCRIPT],
				stdout=logf, stderr=subprocess.STDOUT).returncode
	if args.native:
		if not args.keep:
			shutil.rmtree(work, ignore_errors=True)
	elif not args.keep:
		# The container writes as root; it removes its own files.
		subprocess.run(["docker", "run", "--rm", "-v", work + ":/work",
			image(args.suite, args.arch), "find", "/work", "-mindepth", "1",
			"-delete"], capture_output=True)
		shutil.rmtree(work, ignore_errors=True)
	return rc == 0, log


def build(args, ports):
	out = os.path.abspath(args.out)
	os.makedirs(os.path.join(out, "logs"), exist_ok=True)
	os.makedirs(args.work, exist_ok=True)
	failed = []
	for port in select(ports, args.ports, args.all):
		ok, log = build_port(port, args, out)
		print("%-24s %s" % (port.name, "ok" if ok else "FAILED  " + log))
		if not ok:
			failed.append(port.name)
	if failed:
		die("failed: " + ", ".join(failed))


# ---- command line -----------------------------------------------------

def main():
	ap = argparse.ArgumentParser(prog="vitruvianporter",
		description="Build V\\OS port packages.")
	ap.add_argument("-C", dest="tree", default=os.environ.get(
		"VITRUVIANPORTS", "."), help="ports tree (default: . or $VITRUVIANPORTS)")
	ap.add_argument("--suite", default="testing-nightly")
	ap.add_argument("--arch", default="amd64")
	ap.add_argument("--native", action="store_true",
		help="use this machine as the build root instead of Docker")
	sub = ap.add_subparsers(dest="cmd", required=True)

	b = sub.add_parser("bootstrap", help="create the build root image")
	b.add_argument("--extra-deb", action="append", metavar="DEB",
		help="install this .deb too (e.g. an unpublished dh-vos)")
	b.add_argument("--no-repo", action="store_true",
		help="leave the V\\OS repository out; vos-dev and dh-vos "
		"come from --extra-deb")

	for name, helptext in (("build", "build ports"), ("check", "lint ports")):
		p = sub.add_parser(name, help=helptext)
		p.add_argument("ports", nargs="*")
		p.add_argument("--all", action="store_true")
		if name == "build":
			p.add_argument("--out", default="out")
			p.add_argument("--work", default=os.path.join(CACHE, "work"))
			p.add_argument("--keep", action="store_true",
				help="keep the work tree")

	sub.add_parser("list", help="list ports in build order")
	args = ap.parse_args()

	if args.cmd == "bootstrap":
		return bootstrap(args)
	ports, broken = find_ports(args.tree)
	for name, why in sorted(broken.items()):
		print("%s: error: unreadable port: %s" % (name, why), file=sys.stderr)
	if args.cmd == "list":
		for p in order(ports, list(ports)):
			print("%-24s %-7s %s" % (p.name, p.kind, p.version))
	elif args.cmd == "check":
		bad = 0
		for p in select(ports, args.ports, args.all):
			errors, warnings = check_port(p)
			for w in warnings:
				print("%s: warning: %s" % (p.name, w))
			for e in errors:
				print("%s: error: %s" % (p.name, e))
			bad += bool(errors)
		bad += len([n for n in broken if args.all or n in args.ports])
		if bad:
			die("%d port(s) failed the check" % bad)
	elif args.cmd == "build":
		if not args.ports and not args.all:
			die("name ports or pass --all")
		if args.native:
			check_native(args)
		build(args, ports)


if __name__ == "__main__":
	main()
